/**
 * @param {number[]} temperatures
 * @return {number[]}
 */
var dailyTemperatures = function(temp) {
    let st=[];
    let ans=[];

    for(let i=temp.length-1; i>=0 ;i--){
        while(st.length>0 && temp[i]>=temp[st[st.length-1]]){
            st.pop();
        }
        if(st.length>0){
            ans[i]=st[st.length-1]-i;
        }else{
            ans[i]=0;
        }
        st.push(i);
    }
    return ans;
    
};

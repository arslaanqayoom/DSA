/**
 * @param {number} k
 * @param {number[]} nums
 */
class KthLargest {
    constructor(k, nums) {
        this.k = k;
        // Initialize the built-in MinPriorityQueue
        this.minHeap = new MinPriorityQueue();
        
        for (let num of nums) {
            this.add(num);
        }
    }

    /** 
     * @param {number} val
     * @return {number}
     */
    add(val) {
        if (this.minHeap.size() < this.k) {
            this.minHeap.enqueue(val);
        } else if (val > this.minHeap.front().element) {
            this.minHeap.enqueue(val);
            this.minHeap.dequeue();
        }
        return this.minHeap.front().element;
    }
}
